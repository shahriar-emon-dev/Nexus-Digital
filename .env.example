# ── DATABASE & REDIS ─────────────────────────────────────────
# PostgreSQL Database URL for Prisma ORM
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexus_db?schema=public"

# Upstash Redis URL & Token for rate limiting and sessions
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="placeholder_upstash_redis_token"
REDIS_URL="redis://default:password@localhost:6379"

# ── AUTHENTICATION ───────────────────────────────────────────
# NextAuth.js v5 (Auth.js) Secret & URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="placeholder-secret-at-least-32-chars-long-for-jwt"

# Optional OAuth Providers
GOOGLE_CLIENT_ID="placeholder_google_client_id"
GOOGLE_CLIENT_SECRET="placeholder_google_client_secret"

# ── STRIPE (PAYMENTS & INVOICING) ────────────────────────────
STRIPE_SECRET_KEY="sk_test_placeholder_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_stripe_webhook_secret"

# ── FUTURE PHASES (PLACEHOLDERS) ─────────────────────────────
# Resend (Email Notifications)
RESEND_API_KEY="re_placeholder_resend_api_key"

# Pusher / Socket.io (Real-time Notifications)
PUSHER_APP_ID="placeholder_pusher_app_id"
PUSHER_KEY="placeholder_pusher_key"
PUSHER_SECRET="placeholder_pusher_secret"
PUSHER_CLUSTER="mt1"
