{
  "name": "nexus-digital-agency",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check:schema": "node scripts/check-schema-contract.mjs",
    "check:server-exports": "node scripts/check-server-exports.mjs",
    "check:onconflict": "node scripts/check-onconflict.mjs",
    "check": "npm run check:schema && npm run check:server-exports && npm run check:onconflict && npm run check:migrations",
    "verify": "npm run check && npm run typecheck && npm run lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "verify:full": "npm run verify && npm run build && npm run e2e",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@upstash/ratelimit": "^1.1.3",
    "@upstash/redis": "^1.31.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.379.0",
    "motion": "^12.42.2",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.62.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5"
  }
}
